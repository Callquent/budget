{# templates/category/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Catégories{% endblock %}

{% set type_labels = {income: 'Recettes', expense: 'Dépenses', transfer: 'Virements'} %}
{% set type_colors = {income: 'success', expense: 'danger', transfer: 'primary'} %}
{% set freq_labels = {monthly: 'Mensuelle', yearly: 'Annuelle', quarterly: 'Trimestrielle', occasional: 'Occasionnelle'} %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-tags me-2 text-primary"></i>Catégories</h1>
    <a href="{{ path('category_new') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nouvelle catégorie
    </a>
</div>

{% for type, categories in grouped %}
    <h5 class="text-{{ type_colors[type] ?? 'secondary' }} mt-4 mb-3">
        <i class="bi bi-circle-fill me-2" style="font-size:.6rem;vertical-align:middle"></i>
        {{ type_labels[type] ?? type }}
    </h5>
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Fréquence</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td class="fw-medium">{{ category.name }}</td>
                            <td>
                                <span class="badge badge-{{ category.frequency }}">
                                    {{ freq_labels[category.frequency] ?? category.frequency }}
                                </span>
                            </td>
                            <td class="text-muted small">{{ category.description ?? '—' }}</td>
                            <td class="text-end">
                                <a href="{{ path('category_edit', {id: category.id}) }}" class="btn btn-outline-primary btn-action me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('category_delete', {id: category.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Supprimer « {{ category.name }} » ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}">
                                    <button class="btn btn-outline-danger btn-action"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% else %}
    <div class="alert alert-info">
        Aucune catégorie. <a href="{{ path('category_new') }}" class="alert-link">En créer une</a>.
    </div>
{% endfor %}
{% endblock %}
