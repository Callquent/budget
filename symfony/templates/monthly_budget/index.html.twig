{# templates/monthly_budget/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Budget {{ year }}{% endblock %}

{% set month_names_full = {
    1: 'Janvier', 2: 'Février', 3: 'Mars', 4: 'Avril', 5: 'Mai', 6: 'Juin',
    7: 'Juillet', 8: 'Août', 9: 'Septembre', 10: 'Octobre', 11: 'Novembre', 12: 'Décembre'
} %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-calendar3 me-2 text-primary"></i>Budget {{ year }}</h1>
</div>

{# Navigation années #}
<div class="card mb-4 p-3">
    <div class="d-flex align-items-center gap-2 year-nav flex-wrap">
        <span class="text-muted me-2 small fw-semibold">ANNÉE</span>
        {% for y in available_years %}
            <a href="{{ path('monthly_budget_year', {year: y}) }}"
               class="btn btn-sm {{ y == year ? 'btn-dark' : 'btn-outline-secondary' }}">
                {{ y }}
                {% if y == current_year %}<span class="badge bg-primary ms-1" style="font-size:.6rem">en cours</span>{% endif %}
            </a>
        {% endfor %}
    </div>
</div>

{# Tableau récapitulatif annuel avec comptes #}
<div class="card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Récapitulatif annuel {{ year }}</span>
        <span class="text-muted small">Solde fin de mois par compte</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th style="min-width:110px">Mois</th>
                    {% for account in accounts %}
                        <th class="text-end" style="min-width:130px">
                            <span class="d-flex align-items-center justify-content-end gap-1">
                                <i class="bi {{ account.type == 'credit' ? 'bi-piggy-bank text-success' : 'bi-wallet2 text-secondary' }} small"></i>
                                {{ account.name }}
                            </span>
                        </th>
                    {% endfor %}
                    <th class="text-end" style="min-width:120px">Total</th>
                    <th class="text-end" style="min-width:100px">Budget prévu</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for m in 1..12 %}
                    {% set budgetRow = summary[m] ?? null %}
                    {# Calcul du total tous comptes pour ce mois #}
                    {% set total_balance = 0 %}
                    {% for account in accounts %}
                        {% set ab = account_balances[account.id][m] ?? null %}
                        {% if ab %}
                            {% set total_balance = total_balance + ab.balance %}
                        {% else %}
                            {% set total_balance = total_balance + account.balance %}
                        {% endif %}
                    {% endfor %}

                    <tr>
                        <td>
                            <a href="{{ path('monthly_budget_month', {year: year, month: m}) }}"
                               class="text-decoration-none fw-semibold text-dark">
                                {{ month_names_full[m] }}
                                {% if year == current_year and m == current_month %}
                                    <span class="badge bg-primary ms-1" style="font-size:.6rem">en cours</span>
                                {% endif %}
                            </a>
                        </td>

                        {% for account in accounts %}
                            {% set ab = account_balances[account.id][m] ?? null %}
                            {% set bal = ab ? ab.balance : account.balance %}
                            {% set credit = ab ? ab.credit : 0 %}
                            {% set debit  = ab ? ab.debit  : 0 %}
                            {# Solde projeté cumulatif depuis le contrôleur #}
                            {% set bal_projected = ab ? ab.balance_projected : bal %}
                            {% set planned_net   = ab ? ab.planned_net : 0 %}
                            <td class="text-end">
                                <div class="fw-semibold {{ bal < 0 ? 'text-danger' : '' }}">
                                    {{ bal|number_format(2, ',', ' ') }} €
                                </div>
                                {% if credit > 0 or debit > 0 %}
                                    <div class="text-muted" style="font-size:.72rem;line-height:1.3">
                                        {% if credit > 0 %}
                                            <span class="text-success">+{{ credit|number_format(0, ',', ' ') }}</span>
                                        {% endif %}
                                        {% if debit > 0 %}
                                            <span class="text-danger ms-1">−{{ debit|number_format(0, ',', ' ') }}</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                                {% if planned_net != 0 %}
                                    <div class="text-muted fst-italic" style="font-size:.72rem;line-height:1.4" title="Solde projeté avec budget prévu">
                                        → <span class="{{ bal_projected < 0 ? 'text-danger' : 'text-info' }}">{{ bal_projected|number_format(2, ',', ' ') }} €</span>
                                    </div>
                                {% endif %}
                            </td>
                        {% endfor %}

                        {# Total tous comptes #}
                        <td class="text-end fw-bold {{ total_balance < 0 ? 'text-danger' : 'text-primary' }}">
                            {{ total_balance|number_format(2, ',', ' ') }} €
                        </td>

                        {# Budget prévu #}
                        <td class="text-end text-muted small">
                            {% if budgetRow %}
                                {{ budgetRow.total_planned|number_format(2, ',', ' ') }} €
                            {% else %}
                                —
                            {% endif %}
                        </td>

                        <td>
                            <a href="{{ path('monthly_budget_month', {year: year, month: m}) }}"
                               class="btn btn-outline-secondary btn-action" title="Détail">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td class="fw-semibold">Solde actuel</td>
                    {% set grand_total = 0 %}
                    {% for account in accounts %}
                        <td class="text-end fw-semibold">
                            {{ account.balance|number_format(2, ',', ' ') }} €
                        </td>
                        {% set grand_total = grand_total + account.balance %}
                    {% endfor %}
                    <td class="text-end fw-bold text-primary">{{ grand_total|number_format(2, ',', ' ') }} €</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
{% endblock %}
