{# templates/subscription/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Abonnements{% endblock %}

{% set freq_labels = {monthly: 'Mensuel', yearly: 'Annuel', quarterly: 'Trimestriel', occasional: 'Occasionnel'} %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-arrow-repeat me-2 text-primary"></i>Abonnements</h1>
    <a href="{{ path('subscription_new') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nouvel abonnement
    </a>
</div>

{% if subscriptions is empty %}
    <div class="alert alert-info">
        Aucun abonnement. <a href="{{ path('subscription_new') }}" class="alert-link">En ajouter un</a>.
    </div>
{% else %}
    {% set active   = subscriptions|filter(s => s.status == 'active') %}
    {% set inactive = subscriptions|filter(s => s.status == 'inactive') %}

    {# Résumé mensuel estimé #}
    {% set monthly_total = 0 %}
    {% for s in active %}
        {% if s.frequency == 'monthly' %}
            {% set monthly_total = monthly_total + s.amount %}
        {% elseif s.frequency == 'yearly' %}
            {% set monthly_total = monthly_total + (s.amount / 12) %}
        {% elseif s.frequency == 'quarterly' %}
            {% set monthly_total = monthly_total + (s.amount / 3) %}
        {% endif %}
    {% endfor %}

    <div class="alert alert-light border mb-4 d-flex align-items-center gap-3">
        <i class="bi bi-info-circle text-primary fs-5"></i>
        <span>Coût mensuel estimé (abonnements actifs) :
            <strong>{{ monthly_total|number_format(2, ',', ' ') }} €</strong>
        </span>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-white">
            <span class="fw-semibold">Actifs</span>
            <span class="badge bg-success ms-2">{{ active|length }}</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Compte</th>
                        <th>Catégorie</th>
                        <th>Fréquence</th>
                        <th class="text-end">Montant</th>
                        <th>Début</th>
                        <th>Fin</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for sub in active %}
                        <tr>
                            <td class="fw-medium">{{ sub.name }}</td>
                            <td>{{ sub.account.name }}</td>
                            <td><span class="badge badge-expense">{{ sub.category.name }}</span></td>
                            <td><span class="badge badge-{{ sub.frequency }}">{{ freq_labels[sub.frequency] ?? sub.frequency }}</span></td>
                            <td class="text-end fw-semibold">{{ sub.amount|number_format(2, ',', ' ') }} €</td>
                            <td class="text-muted small">{{ sub.startDate|date('d/m/Y') }}</td>
                            <td class="text-muted small">{{ sub.endDate ? sub.endDate|date('d/m/Y') : '∞' }}</td>
                            <td class="text-end">
                                <a href="{{ path('subscription_edit', {id: sub.id}) }}" class="btn btn-outline-primary btn-action me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('subscription_toggle', {id: sub.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle-sub-'~sub.id) }}">
                                    <button class="btn btn-outline-warning btn-action me-1" title="Désactiver">
                                        <i class="bi bi-pause"></i>
                                    </button>
                                </form>
                                <form method="post" action="{{ path('subscription_delete', {id: sub.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Supprimer cet abonnement ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-sub-'~sub.id) }}">
                                    <button class="btn btn-outline-danger btn-action"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-muted text-center py-3">Aucun abonnement actif.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if inactive|length > 0 %}
        <div class="card">
            <div class="card-header bg-white">
                <span class="fw-semibold text-muted">Inactifs</span>
                <span class="badge bg-secondary ms-2">{{ inactive|length }}</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nom</th><th>Compte</th><th>Catégorie</th><th>Fréquence</th>
                            <th class="text-end">Montant</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sub in inactive %}
                            <tr class="text-muted">
                                <td>{{ sub.name }}</td>
                                <td>{{ sub.account.name }}</td>
                                <td>{{ sub.category.name }}</td>
                                <td>{{ freq_labels[sub.frequency] ?? sub.frequency }}</td>
                                <td class="text-end">{{ sub.amount|number_format(2, ',', ' ') }} €</td>
                                <td class="text-end">
                                    <a href="{{ path('subscription_edit', {id: sub.id}) }}" class="btn btn-outline-secondary btn-action me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('subscription_toggle', {id: sub.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-sub-'~sub.id) }}">
                                        <button class="btn btn-outline-success btn-action me-1" title="Réactiver">
                                            <i class="bi bi-play"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endif %}
{% endblock %}
