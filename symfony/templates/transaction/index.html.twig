{# templates/transaction/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Transactions — {{ month_label }} {{ year }}{% endblock %}

{% set now_year  = "now"|date("Y") %}
{% set now_month = "now"|date("n") %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-list-ul me-2 text-primary"></i>Transactions
    </h1>
    <a href="{{ path('transaction_new', {year: year, month: month}) }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nouvelle transaction
    </a>
</div>

{# ── Sélecteur mois/année ─────────────────────────────────────────────────── #}
<div class="card mb-4 p-3">
    <form method="get" class="d-flex align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted small fw-semibold mb-0">MOIS</label>
            <select name="month" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                {% for num, name in months %}
                    <option value="{{ num }}" {{ num == month ? 'selected' : '' }}>{{ name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted small fw-semibold mb-0">ANNÉE</label>
            <select name="year" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                {% for y in range(now_year - 2, now_year + 1) %}
                    <option value="{{ y }}" {{ y == year ? 'selected' : '' }}>{{ y }}</option>
                {% endfor %}
            </select>
        </div>
        {% set prev = (year ~ '-' ~ month ~ '-01')|date_modify('-1 month') %}
        {% set next = (year ~ '-' ~ month ~ '-01')|date_modify('+1 month') %}
        <div class="ms-auto d-flex gap-2">
            <a href="{{ path('transaction_index', {year: prev|date('Y'), month: prev|date('n')}) }}"
               class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-left"></i></a>
            <a href="{{ path('transaction_index', {year: now_year, month: now_month}) }}"
               class="btn btn-outline-secondary btn-sm">Aujourd'hui</a>
            <a href="{{ path('transaction_index', {year: next|date('Y'), month: next|date('n')}) }}"
               class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-right"></i></a>
        </div>
    </form>
</div>

{# ── Résumé global du mois ────────────────────────────────────────────────── #}
{% set net_global = total_credit - total_debit %}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:44px;height:44px;background:#d1fae5">
                    <i class="bi bi-arrow-down-circle text-success fs-5"></i>
                </div>
                <div>
                    <div class="small text-muted">Total crédits</div>
                    <div class="fw-bold fs-5 text-success">+{{ total_credit|number_format(2, ',', ' ') }} €</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:44px;height:44px;background:#fee2e2">
                    <i class="bi bi-arrow-up-circle text-danger fs-5"></i>
                </div>
                <div>
                    <div class="small text-muted">Total débits</div>
                    <div class="fw-bold fs-5 text-danger">−{{ total_debit|number_format(2, ',', ' ') }} €</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:44px;height:44px;background:{{ net_global >= 0 ? '#dbeafe' : '#fef3c7' }}">
                    <i class="bi bi-wallet2 {{ net_global >= 0 ? 'text-primary' : 'text-warning' }} fs-5"></i>
                </div>
                <div>
                    <div class="small text-muted">Net du mois</div>
                    <div class="fw-bold fs-5 {{ net_global >= 0 ? 'text-primary' : 'text-warning' }}">
                        {{ net_global >= 0 ? '+' : '' }}{{ net_global|number_format(2, ',', ' ') }} €
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Tableaux par compte (toujours affichés) ─────────────────────────────── #}
{% for row in by_account %}
    {% set acc      = row.account %}
    {% set credit   = row.credit %}
    {% set debit    = row.debit %}
    {% set net      = credit - debit %}
    {% set bal_end  = row.balance_end %}
    {% set acc_txs  = tx_by_account_id[acc.id] ?? [] %}

    <div class="card mb-4">
        {# En-tête compte #}
        <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:38px;height:38px;background:{{ acc.type == 'credit' ? '#d1fae5' : '#fee2e2' }}">
                    <i class="bi {{ acc.type == 'credit' ? 'bi-piggy-bank text-success' : 'bi-wallet2 text-danger' }} fs-6"></i>
                </div>
                <div>
                    <span class="fw-semibold fs-6">{{ acc.name }}</span>
                    <span class="text-muted small ms-2">
                        Solde fin {{ month_label }} :
                        <strong class="{{ bal_end < 0 ? 'text-danger' : 'text-dark' }}">
                            {{ bal_end|number_format(2, ',', ' ') }} {{ acc.currency }}
                        </strong>
                    </span>
                </div>
            </div>
            {# Mini résumé net dans l'en-tête #}
            <div class="d-flex gap-3 align-items-center">
                {% if credit > 0 %}
                    <span class="small text-success fw-semibold">
                        <i class="bi bi-arrow-down-circle me-1"></i>+{{ credit|number_format(2, ',', ' ') }} €
                    </span>
                {% endif %}
                {% if debit > 0 %}
                    <span class="small text-danger fw-semibold">
                        <i class="bi bi-arrow-up-circle me-1"></i>−{{ debit|number_format(2, ',', ' ') }} €
                    </span>
                {% endif %}
                {% if credit > 0 or debit > 0 %}
                    <span class="badge {{ net >= 0 ? 'bg-success' : 'bg-danger' }} bg-opacity-10 {{ net >= 0 ? 'text-success' : 'text-danger' }} fw-semibold">
                        Net {{ net >= 0 ? '+' : '' }}{{ net|number_format(2, ',', ' ') }} €
                    </span>
                {% else %}
                    <span class="badge bg-secondary bg-opacity-10 text-muted fw-semibold">Aucun mouvement</span>
                {% endif %}
            </div>
        </div>

        {# Tableau crédit | débit en deux colonnes côte à côte #}
        <div class="row g-0">

            {# Colonne CRÉDIT #}
            <div class="col-md-6 border-end">
                <div class="px-3 py-2 bg-light border-bottom">
                    <span class="small fw-semibold text-success">
                        <i class="bi bi-arrow-down-circle me-1"></i>CRÉDIT — entrées
                    </span>
                </div>
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Libellé</th>
                            <th class="text-end pe-3">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set credit_txs = acc_txs|filter(t => t.type == 'credit') %}
                        {% if credit_txs|length == 0 %}
                            <tr>
                                <td colspan="3" class="text-muted small text-center py-3 ps-3">
                                    Aucune entrée
                                </td>
                            </tr>
                        {% else %}
                            {% for tx in credit_txs %}
                            <tr>
                                <td class="ps-3 text-muted small" style="white-space:nowrap">
                                    {{ tx.transactionDate|date('d/m') }}
                                </td>
                                <td>
                                    <div class="small fw-medium">{{ tx.label }}</div>
                                    <div>
                                        <span class="badge badge-income" style="font-size:.65rem">{{ tx.category.name }}</span>
                                    </div>
                                </td>
                                <td class="text-end pe-3 text-success fw-semibold small" style="white-space:nowrap">
                                    +{{ tx.amount|number_format(2, ',', ' ') }} €
                                </td>
                            </tr>
                            {% endfor %}
                            <tr class="table-success">
                                <td colspan="2" class="ps-3 small fw-semibold">Total crédits</td>
                                <td class="text-end pe-3 fw-bold text-success small">
                                    +{{ credit|number_format(2, ',', ' ') }} €
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>

            {# Colonne DÉBIT #}
            <div class="col-md-6">
                <div class="px-3 py-2 bg-light border-bottom">
                    <span class="small fw-semibold text-danger">
                        <i class="bi bi-arrow-up-circle me-1"></i>DÉBIT — sorties
                    </span>
                </div>
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Libellé</th>
                            <th class="text-end pe-3">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set debit_txs = acc_txs|filter(t => t.type != 'credit') %}
                        {% if debit_txs|length == 0 %}
                            <tr>
                                <td colspan="3" class="text-muted small text-center py-3 ps-3">
                                    Aucune sortie
                                </td>
                            </tr>
                        {% else %}
                            {% for tx in debit_txs %}
                            <tr>
                                <td class="ps-3 text-muted small" style="white-space:nowrap">
                                    {{ tx.transactionDate|date('d/m') }}
                                </td>
                                <td>
                                    <div class="small fw-medium">{{ tx.label }}</div>
                                    <div>
                                        <span class="badge badge-{{ tx.category.transactionType == 'expense' ? 'expense' : 'transfer' }}"
                                              style="font-size:.65rem">{{ tx.category.name }}</span>
                                    </div>
                                </td>
                                <td class="text-end pe-3 text-danger fw-semibold small" style="white-space:nowrap">
                                    −{{ tx.amount|number_format(2, ',', ' ') }} €
                                </td>
                            </tr>
                            {% endfor %}
                            <tr class="table-danger">
                                <td colspan="2" class="ps-3 small fw-semibold">Total débits</td>
                                <td class="text-end pe-3 fw-bold text-danger small">
                                    −{{ debit|number_format(2, ',', ' ') }} €
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>

        </div>{# /row #}

        {# Pied de carte #}
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">{{ acc_txs|length }} transaction{{ acc_txs|length > 1 ? 's' : '' }}</span>
            <a href="{{ path('transaction_new', {year: year, month: month}) }}"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Ajouter
            </a>
        </div>
    </div>
{% endfor %}

{# ── Tableau global (édition / suppression) ───────────────────────────────── #}
<div class="card mt-2">
    <div class="card-header bg-white">
        <span class="fw-semibold small text-muted">
            <i class="bi bi-pencil-square me-2"></i>Toutes les transactions — édition / suppression
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0 align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Libellé</th>
                    <th>Catégorie</th>
                    <th>Compte</th>
                    <th class="text-end">Crédit</th>
                    <th class="text-end">Débit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for tx in transactions %}
                <tr>
                    <td class="text-muted small">{{ tx.transactionDate|date('d/m/Y') }}</td>
                    <td>
                        <span class="fw-medium small">{{ tx.label }}</span>
                        {% if tx.notes %}
                            <div class="text-muted" style="font-size:.7rem">{{ tx.notes }}</div>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge
                            {% if tx.category.transactionType == 'income' %}badge-income
                            {% elseif tx.category.transactionType == 'expense' %}badge-expense
                            {% else %}badge-transfer{% endif %}" style="font-size:.7rem">
                            {{ tx.category.name }}
                        </span>
                    </td>
                    <td class="small text-muted">{{ tx.account.name }}</td>
                    <td class="text-end small {{ tx.type == 'credit' ? 'text-success fw-semibold' : 'text-muted' }}">
                        {% if tx.type == 'credit' %}+{{ tx.amount|number_format(2, ',', ' ') }} €{% else %}—{% endif %}
                    </td>
                    <td class="text-end small {{ tx.type != 'credit' ? 'text-danger fw-semibold' : 'text-muted' }}">
                        {% if tx.type != 'credit' %}−{{ tx.amount|number_format(2, ',', ' ') }} €{% else %}—{% endif %}
                    </td>
                    <td class="text-end" style="white-space:nowrap">
                        <a href="{{ path('transaction_edit', {id: tx.id}) }}"
                           class="btn btn-outline-primary btn-action me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post"
                              action="{{ path('transaction_delete', {id: tx.id}) }}"
                              class="d-inline"
                              onsubmit="return confirm('Supprimer cette transaction ?')">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete-tx-' ~ tx.id) }}">
                            <button class="btn btn-outline-danger btn-action">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot class="table-light fw-semibold">
                <tr>
                    <td colspan="4">Total</td>
                    <td class="text-end text-success">+{{ total_credit|number_format(2, ',', ' ') }} €</td>
                    <td class="text-end text-danger">−{{ total_debit|number_format(2, ',', ' ') }} €</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

{% endblock %}
