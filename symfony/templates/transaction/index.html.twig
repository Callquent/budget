{# templates/transaction/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Transactions — {{ month_label }} {{ year }}{% endblock %}

{% set now_year  = "now"|date("Y") %}
{% set now_month = "now"|date("n") %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-list-ul me-2 text-primary"></i>Transactions
    </h1>
    <a href="{{ path('transaction_new', {year: year, month: month}) }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nouvelle transaction
    </a>
</div>

{# Sélecteur mois/année #}
<div class="card mb-4 p-3">
    <form method="get" class="d-flex align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted small fw-semibold mb-0">MOIS</label>
            <select name="month" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                {% for num, name in months %}
                    <option value="{{ num }}" {{ num == month ? 'selected' : '' }}>{{ name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted small fw-semibold mb-0">ANNÉE</label>
            <select name="year" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                {% for y in range(now_year - 2, now_year + 1) %}
                    <option value="{{ y }}" {{ y == year ? 'selected' : '' }}>{{ y }}</option>
                {% endfor %}
            </select>
        </div>
        {# Navigation mois précédent / suivant #}
        {% set prev = (year ~ '-' ~ month ~ '-01')|date_modify('-1 month') %}
        {% set next = (year ~ '-' ~ month ~ '-01')|date_modify('+1 month') %}
        <div class="ms-auto d-flex gap-2">
            <a href="{{ path('transaction_index', {year: prev|date('Y'), month: prev|date('n')}) }}"
               class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-left"></i></a>
            <a href="{{ path('transaction_index', {year: now_year, month: now_month}) }}"
               class="btn btn-outline-secondary btn-sm">Aujourd'hui</a>
            <a href="{{ path('transaction_index', {year: next|date('Y'), month: next|date('n')}) }}"
               class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-right"></i></a>
        </div>
    </form>
</div>

{# ── Soldes des comptes ──────────────────────────────────────────────────── #}
<div class="row g-3 mb-4">
    {% for row in by_account %}
        {% set acc    = row.account %}
        {% set credit = row.credit %}
        {% set debit  = row.debit %}
        {% set net    = credit - debit %}
        <div class="col-md-4 col-sm-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:40px;height:40px;background:{{ acc.type == 'credit' ? '#d1fae5' : '#fee2e2' }}">
                            <i class="bi {{ acc.type == 'credit' ? 'bi-piggy-bank text-success' : 'bi-wallet2 text-danger' }} fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">{{ acc.name }}</div>
                            <div class="small text-muted">
                                Solde actuel : <strong>{{ acc.balance|number_format(2, ',', ' ') }} {{ acc.currency }}</strong>
                            </div>
                        </div>
                    </div>
                    {% if credit > 0 or debit > 0 %}
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-success"><i class="bi bi-arrow-down-circle me-1"></i>Entrées</span>
                            <span class="fw-medium text-success">+{{ credit|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="text-danger"><i class="bi bi-arrow-up-circle me-1"></i>Sorties</span>
                            <span class="fw-medium text-danger">−{{ debit|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <div class="border-top pt-2 d-flex justify-content-between small fw-semibold">
                            <span>Net du mois</span>
                            <span class="{{ net >= 0 ? 'text-success' : 'text-danger' }}">
                                {{ net >= 0 ? '+' : '' }}{{ net|number_format(2, ',', ' ') }} €
                            </span>
                        </div>
                    {% else %}
                        <div class="text-muted small text-center py-1">
                            <i class="bi bi-dash-circle me-1"></i>Aucun mouvement ce mois
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{# Résumé du mois #}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:44px;height:44px;background:#d1fae5">
                    <i class="bi bi-arrow-down-circle text-success fs-5"></i>
                </div>
                <div>
                    <div class="small text-muted">Entrées</div>
                    <div class="fw-bold fs-5 text-success">+{{ total_credit|number_format(2, ',', ' ') }} €</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:44px;height:44px;background:#fee2e2">
                    <i class="bi bi-arrow-up-circle text-danger fs-5"></i>
                </div>
                <div>
                    <div class="small text-muted">Sorties</div>
                    <div class="fw-bold fs-5 text-danger">−{{ total_debit|number_format(2, ',', ' ') }} €</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        {% set net = total_credit - total_debit %}
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:44px;height:44px;background:{{ net >= 0 ? '#dbeafe' : '#fef3c7' }}">
                    <i class="bi bi-wallet2 {{ net >= 0 ? 'text-primary' : 'text-warning' }} fs-5"></i>
                </div>
                <div>
                    <div class="small text-muted">Net du mois</div>
                    <div class="fw-bold fs-5 {{ net >= 0 ? 'text-primary' : 'text-warning' }}">
                        {{ net >= 0 ? '+' : '' }}{{ net|number_format(2, ',', ' ') }} €
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Tableau des transactions #}
{% if transactions is empty %}
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-info-circle fs-5"></i>
        <span>Aucune transaction pour {{ month_label }} {{ year }}.
            <a href="{{ path('transaction_new', {year: year, month: month}) }}" class="alert-link">En ajouter une</a>.
        </span>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Libellé</th>
                        <th>Catégorie</th>
                        <th>Compte</th>
                        <th class="text-end">Montant</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for tx in transactions %}
                        <tr>
                            <td class="text-muted small">{{ tx.transactionDate|date('d/m/Y') }}</td>
                            <td>
                                <span class="fw-medium">{{ tx.label }}</span>
                                {% if tx.notes %}
                                    <div class="text-muted small">{{ tx.notes }}</div>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge
                                    {% if tx.category.transactionType == 'income' %}badge-income
                                    {% elseif tx.category.transactionType == 'expense' %}badge-expense
                                    {% else %}badge-transfer{% endif %}">
                                    {{ tx.category.name }}
                                </span>
                            </td>
                            <td class="small text-muted">{{ tx.account.name }}</td>
                            <td class="text-end fw-semibold
                                {{ tx.type == 'credit' ? 'text-success' : 'text-danger' }}">
                                {{ tx.type == 'credit' ? '+' : '−' }}{{ tx.amount|number_format(2, ',', ' ') }} €
                            </td>
                            <td class="text-end">
                                <a href="{{ path('transaction_edit', {id: tx.id}) }}"
                                   class="btn btn-outline-primary btn-action me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post"
                                      action="{{ path('transaction_delete', {id: tx.id}) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Supprimer cette transaction ?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete-tx-' ~ tx.id) }}">
                                    <button class="btn btn-outline-danger btn-action">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}
