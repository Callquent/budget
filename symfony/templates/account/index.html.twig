{# templates/account/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Comptes{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-bank me-2 text-primary"></i>Comptes</h1>
    <a href="{{ path('account_new') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nouveau compte
    </a>
</div>

{% if accounts is empty %}
    <div class="alert alert-info">Aucun compte. <a href="{{ path('account_new') }}" class="alert-link">En créer un</a>.</div>
{% else %}
    <div class="row g-3">
        {% for account in accounts %}
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title mb-1">{{ account.name }}</h5>
                                <span class="badge {{ account.type == 'credit' ? 'bg-success' : 'bg-secondary' }}">
                                    {{ account.type == 'credit' ? 'Crédit' : 'Débit' }}
                                </span>
                            </div>
                            <span class="fs-5 fw-bold text-primary">
                                {{ account.balance|number_format(2, ',', ' ') }} {{ account.currency }}
                            </span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a href="{{ path('account_edit', {id: account.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Modifier
                        </a>
                        <form method="post" action="{{ path('account_delete', {id: account.id}) }}"
                              onsubmit="return confirm('Supprimer ce compte ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-account-' ~ account.id) }}">
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
